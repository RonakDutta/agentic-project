# Groq API Configuration (free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model chain: each model has its own free-tier budget, so three models pool
# three budgets. Verify ids at https://console.groq.com/docs/models.
PRIMARY_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
CODE_MODEL=qwen/qwen3.8-27b
# MODEL_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Reasoning models: low effort keeps hidden "thinking" tokens small.
REASONING_EFFORT=low

# Request limits
MAX_TOKENS_PER_REQ=2500
TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=2

# Groq free-tier limits per model (check console.groq.com/settings/limits).
# The client enforces these locally from the first call.
FREE_TIER_RPM=30
FREE_TIER_RPD=1000
FREE_TIER_TPM=8000
FREE_TIER_TPD=200000

# Caching: identical prompts cost zero quota. The disk cache survives restarts.
LLM_CACHE_TTL_SECONDS=600
LLM_DISK_CACHE=1
LLM_DISK_CACHE_TTL_SECONDS=604800

# Web search: Tavily free tier is used first when set; otherwise DuckDuckGo (ddgs).
TAVILY_API_KEY=

# Research paper search (arXiv + Semantic Scholar + OpenAlex). All three work
# without keys; free keys avoid shared per-IP rate limits (HTTP 429) in a demo.
# arXiv needs no key at all.
PRIOR_ART_ENABLED=1
# Semantic Scholar: request a free key at https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex: free key, see https://help.openalex.org/api/authentication/ (or POST {"email": ...} to
# https://api.openalex.org/api-keys). OPENALEX_EMAIL alone also helps (polite pool).
OPENALEX_API_KEY=
OPENALEX_EMAIL=
# Cache real paper search results for 7 days (.cache/papers.sqlite). 0 = off.
PAPER_CACHE=1

# Server safety. Set ALLOWED_REPO_ROOTS before anyone else can reach the app
# (folders separated by ; on Windows, : elsewhere). Empty = any local folder.
ALLOWED_REPO_ROOTS=
RUNS_PER_MINUTE=6
MAX_REPO_FILES=400
MAX_CLONE_MB=200
