# Groq API Configuration (Obtain free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Production Models
PRIMARY_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
CODE_MODEL=qwen/qwen3.8-27b

# Agent Budgets & Limits
MAX_TOKENS_PER_REQ=4096
TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3
